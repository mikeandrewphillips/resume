#!/bin/sh
# Regenerate / validate every resume format before a commit is created.
# Tracked hook: enabled via `git config core.hooksPath .githooks`
# (done by `make setup` / `make hooks`).
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Only rebuild when something that affects the output is staged.
if ! git diff --cached --name-only \
     | grep -qE '^(resume\.yaml|build\.py|templates/|latex/|fonts/)'; then
  exit 0
fi

if [ ! -x .venv/bin/python ]; then
  echo "pre-commit: .venv missing - run 'make setup' first" >&2
  exit 1
fi

echo "pre-commit: building all resume formats..."
make all
